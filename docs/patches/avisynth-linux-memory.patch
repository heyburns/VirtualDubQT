+++ b/avs_core/core/memory_helpers.h
@@ -0,0 +1,44 @@
+#ifndef AVS_CORE_MEMORY_HELPERS_H
+#define AVS_CORE_MEMORY_HELPERS_H
+
+#include <algorithm>
+#include <cstdint>
+#include <istream>
+#include <limits>
+#include <sstream>
+#include <string>
+
+namespace avs_memory {
+
+// Linux's MemFree/sysconf(_SC_AVPHYS_PAGES) excludes reclaimable page cache.
+// MemAvailable estimates RAM usable without swapping, which is the quantity
+// needed when sizing a video cache. Parse a stream to allow fixture-only tests.
+inline bool ReadLinuxAvailable(std::istream& input, uint64_t& bytes)
+{
+  std::string line;
+  while (std::getline(input, line)) {
+    std::istringstream fields(line);
+    std::string key, unit;
+    uint64_t kib;
+    if (!(fields >> key) || key != "MemAvailable:")
+      continue;
+    if (!(fields >> kib >> unit) || unit != "kB"
+        || kib > static_cast<uint64_t>(std::numeric_limits<int64_t>::max()) / 1024)
+      return false;
+    bytes = kib * 1024;
+    return true;
+  }
+  return false;
+}
+
+inline uint64_t Constrain(uint64_t requested, uint64_t limit, uint64_t reserve)
+{
+  constexpr uint64_t minimum = 64 * 1024 * 1024;
+  // Saturate before subtracting: low-memory hosts must not wrap the unsigned
+  // limit into an enormous allocation allowance. Preserve the existing floor.
+  const uint64_t maximum = limit > reserve ? limit - reserve : 0;
+  return std::max(minimum, std::min(requested, maximum));
+}
+
+} // namespace avs_memory
+#endif
