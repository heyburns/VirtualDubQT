+    while (!frame_cache.empty() && (frame_cache.size() >= frame_cache_capacity
+        || bytes > frame_cache_budget - pinned_bytes - frame_cache_bytes)) {
+        frame_cache_bytes -= frame_cache.front().bytes;
+        frame_cache.pop_front();
+    }
+    if (bytes <= frame_cache_budget - pinned_bytes - frame_cache_bytes) {
+        frame_cache.push_back({ n, frame, bytes });
+        frame_cache_bytes += bytes;
+    }
