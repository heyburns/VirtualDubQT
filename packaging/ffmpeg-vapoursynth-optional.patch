+/* Like AviSynth, load the independently installed framework only for scripts.
+ * Keep code resident: Python extension objects can survive a script/context.
+ * The AVBufferRef owns the loader handle until the final output frame dies.
+ */
+static int load_vss_library(AVFormatContext *s, struct VSState *vss)
+{
+    int flags = RTLD_NOW | RTLD_GLOBAL;
+#ifdef RTLD_NODELETE
+    flags |= RTLD_NODELETE;
+#endif
+    vss->library = dlopen("libvapoursynth-script.so", flags);
+    if (!vss->library)
+        vss->library = dlopen("libvapoursynth-script.so.0", flags);
+    if (!vss->library) {
+        av_log(s, AV_LOG_ERROR, "VapourSynth is not installed or cannot be loaded: %s\n", dlerror());
+        return AVERROR_EXTERNAL;
+    }
+#define LOAD_VSS_FUNC(member, symbol) do {                                    \
+    *(void **)(&vss->member) = dlsym(vss->library, symbol);                    \
+    if (!vss->member) {                                                      \
+        av_log(s, AV_LOG_ERROR, "VapourSynth API 3.2 symbol missing: %s\n", symbol); \
+        return AVERROR_EXTERNAL;                                            \
+    }                                                                       \
+} while (0)
+    LOAD_VSS_FUNC(init, "vsscript_init");
+    LOAD_VSS_FUNC(finalize, "vsscript_finalize");
+    LOAD_VSS_FUNC(createScript, "vsscript_createScript");
+    LOAD_VSS_FUNC(freeScript, "vsscript_freeScript");
+    LOAD_VSS_FUNC(evaluateScript, "vsscript_evaluateScript");
+    LOAD_VSS_FUNC(getError, "vsscript_getError");
+    LOAD_VSS_FUNC(getVSApi2, "vsscript_getVSApi2");
+    LOAD_VSS_FUNC(getCore, "vsscript_getCore");
+    LOAD_VSS_FUNC(getOutput, "vsscript_getOutput");
+#undef LOAD_VSS_FUNC
+    return 0;
 }
 
